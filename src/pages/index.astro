---
import Layout from '../layouts/Layout.astro';
import Splash from '../components/Splash.astro';
import Camara from '../components/Camara.astro';
import Revision from '../components/Revision.astro';
import Cobro from '../components/Cobro.astro';
import { ruta } from '../lib/rutas';
---

<Layout>
	<Splash />

	<div class="app">
	<header class="barra">
		<img class="productor" src={ruta('img/huella-pampa.jpg')} alt="Huella Pampa" width="150" height="150" />
		<div>
			<p class="titulo">Ventas de Feria</p>
			<p class="subtitulo">Lácteos Huella Pampa</p>
		</div>
	</header>

	<main id="contenido" class="contenido">
		<!-- "Vender" entra entero en la pantalla: la hoja ocupa el espacio libre y los botones quedan abajo, al alcance del pulgar. -->
		<div id="panel-vender" class="panel panel-vender" role="tabpanel" aria-labelledby="pestana-vender">
		<section class="ventas-abiertas" aria-labelledby="abiertas-titulo">
			<h2 id="abiertas-titulo" class="visualmente-oculto">Ventas abiertas</h2>
			<div id="carrusel-abiertas" class="carrusel"></div>
		</section>

		<section class="acciones" aria-labelledby="acciones-titulo">
			<h2 id="acciones-titulo" class="visualmente-oculto">Agregar un producto a la venta que se ve</h2>
			<button id="btn-camara" class="accion principal" type="button" hidden>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M4 8a2 2 0 0 1 2-2h2l1.5-2h5L16 6h2a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"></path>
					<circle cx="12" cy="13" r="3.5"></circle>
				</svg>
				<span>Escanear</span>
			</button>

			<label id="btn-galeria" class="accion principal">
				<input id="input-galeria" type="file" accept="image/*" hidden />
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="3" y="4" width="18" height="16" rx="3"></rect>
					<circle cx="9" cy="10" r="2"></circle>
					<path d="M21 16l-5-5-9 9"></path>
				</svg>
				<span>Foto del ticket</span>
			</label>

			<!-- Respaldo de la cámara si el navegador no deja usarla dentro de la app. -->
			<input id="input-camara-sistema" type="file" accept="image/*" capture="environment" hidden />

			<button id="btn-manual" class="accion secundaria" type="button">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4"></path></svg>
				<span>A mano</span>
			</button>
		</section>
		</div>

		<div id="panel-dia" class="panel" role="tabpanel" aria-labelledby="pestana-dia" hidden>
		<section class="resumen" aria-labelledby="resumen-titulo">
			<h1 id="resumen-titulo">Vendido hoy</h1>
			<p id="resumen-total" class="resumen-total">$ 0,00</p>
			<p id="resumen-detalle" class="resumen-detalle">Todavía no hay ventas hoy</p>
			<ul id="resumen-marcas" class="resumen-marcas" aria-label="Total por marca"></ul>
			<ul id="resumen-pagos" class="resumen-marcas resumen-pagos" aria-label="Total por medio de pago"></ul>
		</section>

		<section class="ventas" aria-labelledby="ventas-titulo">
			<header class="ventas-cabecera">
				<h2 id="ventas-titulo">Ventas de hoy</h2>
				<div class="ventas-botones">
				<button id="btn-reporte" class="exportar" type="button" disabled aria-label="Reporte de hoy en PDF">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V4h10v5M7 18H4v-7h16v7h-3M7 14h10v6H7z"></path></svg>
					PDF
				</button>
				<button id="btn-exportar" class="exportar" type="button" disabled>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
					Exportar
				</button>
				</div>
			</header>
			<div id="lista-ventas" class="lista"></div>
		</section>

		<details id="anteriores-panel" class="canceladas-panel" hidden>
			<summary>Días anteriores</summary>
			<div id="lista-anteriores" class="lista anteriores"></div>
		</details>

		<details id="canceladas-panel" class="canceladas-panel" hidden>
			<summary>Ventas canceladas</summary>
			<div id="lista-canceladas"></div>
		</details>
		</div>
	</main>

	<nav class="pestanas" role="tablist" aria-label="Secciones">
		<button id="pestana-vender" class="pestana" type="button" role="tab" aria-controls="panel-vender" aria-selected="true">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"></path><path d="M14 3v5h5M9 13h7M9 17h5"></path></svg>
			<span>Vender</span>
			<span id="contador-abiertas" class="contador" hidden></span>
		</button>
		<button id="pestana-dia" class="pestana" type="button" role="tab" aria-controls="panel-dia" aria-selected="false">
			<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg>
			<span>Ventas del día</span>
			<span id="contador-dia" class="contador" hidden></span>
		</button>
	</nav>
	</div>

	<div id="aviso" class="aviso" role="status" aria-live="polite" hidden></div>

	<Camara />
	<Revision />
	<Cobro />
</Layout>

<script>
	import { abrirCamara, esCelular, hayCamara } from '../lib/ui/camara';
	import { abrirRevision } from '../lib/ui/revision';
	import { abrirCobro } from '../lib/ui/cobro';
	import { deuda, estadoCobro } from '../lib/pagos';
	import { hora } from '../lib/formato';
	import {
		avisar,
		centrarVentaActiva,
		dibujarCanceladas,
		dibujarLista,
		dibujarResumen,
		dibujarVentasAbiertas,
	} from '../lib/ui/lista';
	import { inicioDelDia, pesos } from '../lib/formato';
	import { leerFoto, prepararLector } from '../lib/tickets/lector';
	import {
		borrarVenta,
		actualizarVenta,
		borrarVentaVacia,
		guardarVenta,
		listarProductos,
		listarVentas,
		nuevoId,
		pedirAlmacenamientoPersistente,
		type Producto,
		type ProductoVenta,
		type Venta,
	} from '../lib/ventas/db';
	import { exportarReporte, exportarVentas } from '../lib/ventas/exportar';

	const lista = document.getElementById('lista-ventas')!;
	const abiertas = document.getElementById('carrusel-abiertas')!;
	const listaCanceladas = document.getElementById('lista-canceladas')!;
	const canceladasPanel = document.getElementById('canceladas-panel') as HTMLDetailsElement;
	const btnCamara = document.getElementById('btn-camara') as HTMLButtonElement;
	const btnGaleria = document.getElementById('btn-galeria')!;
	const inputGaleria = document.getElementById('input-galeria') as HTMLInputElement;
	const inputCamaraSistema = document.getElementById('input-camara-sistema') as HTMLInputElement;
	const btnManual = document.getElementById('btn-manual') as HTMLButtonElement;
	const btnExportar = document.getElementById('btn-exportar') as HTMLButtonElement;
	const btnReporte = document.getElementById('btn-reporte') as HTMLButtonElement;
	const listaAnteriores = document.getElementById('lista-anteriores')!;
	const anterioresPanel = document.getElementById('anteriores-panel') as HTMLDetailsElement;
	const contenido = document.getElementById('contenido')!;
	const contadorAbiertas = document.getElementById('contador-abiertas')!;
	const contadorDia = document.getElementById('contador-dia')!;
	const PESTANAS = {
		vender: { boton: document.getElementById('pestana-vender')!, panel: document.getElementById('panel-vender')! },
		dia: { boton: document.getElementById('pestana-dia')!, panel: document.getElementById('panel-dia')! },
	};
	type Pestana = keyof typeof PESTANAS;
	const PESTANA_GUARDADA = 'pestana';

	function mostrarPestana(nombre: Pestana) {
		for (const [clave, { boton, panel }] of Object.entries(PESTANAS)) {
			const activa = clave === nombre;
			boton.setAttribute('aria-selected', String(activa));
			boton.tabIndex = activa ? 0 : -1;
			panel.hidden = !activa;
		}
		sessionStorage.setItem(PESTANA_GUARDADA, nombre);
		contenido.scrollTop = 0;
		if (nombre === 'vender') centrarVentaActiva();
	}

	for (const [clave, { boton }] of Object.entries(PESTANAS)) {
		boton.addEventListener('click', () => mostrarPestana(clave as Pestana));
		boton.addEventListener('keydown', (evento) => {
			if (evento.key !== 'ArrowLeft' && evento.key !== 'ArrowRight') return;
			const otra: Pestana = clave === 'vender' ? 'dia' : 'vender';
			mostrarPestana(otra);
			PESTANAS[otra].boton.focus();
		});
	}
	mostrarPestana(sessionStorage.getItem(PESTANA_GUARDADA) === 'dia' ? 'dia' : 'vender');

	let ventas: Venta[] = [];
	let productos: Producto[] = [];
	let ventaActivaId: string | null = null;

	// En el celular: cámara de la app + galería. En la PC: solo cargar una foto.
	if (esCelular()) {
		btnCamara.hidden = false;
		btnGaleria.classList.replace('principal', 'secundaria');
		btnGaleria.querySelector('span')!.textContent = 'Galería';
	}

	const ULTIMA_MARCA = 'ultima-marca';
	// Las hojas van de la más vieja a la más nueva: una venta nueva se suma al final de la pila.
	const abiertasActuales = () => ventas.filter((v) => v.estado === 'abierta').sort((a, b) => a.creada - b.creada);
	const ventaActiva = () => abiertasActuales().find((v) => v.id === ventaActivaId);

	function contar(elemento: HTMLElement, cantidad: number) {
		elemento.hidden = cantidad === 0;
		elemento.textContent = String(cantidad);
	}

	async function refrescar() {
		[ventas, productos] = await Promise.all([listarVentas(), listarProductos()]);
		const pendientes = abiertasActuales();
		if (!pendientes.some((v) => v.id === ventaActivaId)) ventaActivaId = pendientes[0]?.id ?? null;
		const finalizadas = ventas.filter((v) => v.estado === 'finalizada');
		const canceladas = ventas.filter((v) => v.estado === 'cancelada');
		const hoy = inicioDelDia(Date.now());
		const esDeHoy = (v: Venta) => (v.finalizada ?? v.creada) >= hoy;
		const deHoy = finalizadas.filter(esDeHoy);
		const anteriores = finalizadas.filter((v) => !esDeHoy(v));
		dibujarResumen(ventas);
		contar(contadorAbiertas, pendientes.length);
		contar(contadorDia, deHoy.length);
		dibujarVentasAbiertas(abiertas, pendientes, ventaActivaId, {
			alSeleccionar(id) {
				ventaActivaId = id;
			},
			alNueva: () => void ejecutar(crearVenta, 'No se pudo iniciar una venta. Intentá de nuevo.'),
			alCambiarCliente: (venta, cliente) =>
				void ejecutar(() => cambiarCliente(venta, cliente), 'No se pudo guardar el cliente. Intentá de nuevo.'),
			alFinalizar: (venta) => void ejecutar(() => finalizar(venta), 'No se pudo finalizar la venta. Intentá de nuevo.'),
			alCancelar: (venta) => void ejecutar(() => cancelar(venta), 'No se pudo cancelar la venta. Intentá de nuevo.'),
		});
		const accionesLista = {
			alEditar: (venta: Venta, producto: ProductoVenta) =>
				void ejecutar(() => editar(venta, producto), 'No se pudieron guardar los cambios. Intentá de nuevo.'),
			alBorrar: (venta: Venta) => void ejecutar(() => borrar(venta), 'No se pudo borrar la venta. Intentá de nuevo.'),
			alSaldar: (venta: Venta) => void ejecutar(() => saldar(venta), 'No se pudo registrar el pago. Intentá de nuevo.'),
		};
		dibujarLista(lista, deHoy, accionesLista, 'Todavía no finalizaste ventas hoy. Las ventas aparecen acá cuando las cobrás.');
		dibujarLista(listaAnteriores, anteriores, { ...accionesLista, alReportar: reportar });
		anterioresPanel.hidden = anteriores.length === 0;
		dibujarCanceladas(listaCanceladas, canceladas);
		canceladasPanel.hidden = canceladas.length === 0;
		btnExportar.disabled = finalizadas.length === 0;
		btnReporte.disabled = deHoy.length === 0;
	}

	async function ejecutar(accion: () => Promise<void>, mensaje: string) {
		try {
			await accion();
		} catch (error) {
			console.error(error);
			avisar(mensaje);
		}
	}

	function reportar(dia: number) {
		void ejecutar(() => exportarReporte(ventas, dia), 'No se pudo armar el PDF. Intentá de nuevo.');
	}

	async function guardar(venta: Venta, mensaje: string, marca?: string) {
		await guardarVenta(venta);
		if (marca) localStorage.setItem(ULTIMA_MARCA, marca);
		void pedirAlmacenamientoPersistente();
		await refrescar();
		avisar(mensaje);
	}

	async function guardarProducto(producto: ProductoVenta, destinoId: string | null) {
		if (destinoId) {
			const existente = await actualizarVenta(destinoId, (actual) =>
				actual.estado === 'abierta' ? { ...actual, productos: [...actual.productos, producto] } : null,
			);
			if (!existente || existente.estado !== 'abierta') {
				avisar('Esa venta ya no está abierta. Elegí otra venta para agregar el producto.');
				await refrescar();
				return;
			}
			localStorage.setItem(ULTIMA_MARCA, producto.marca);
			void pedirAlmacenamientoPersistente();
			await refrescar();
			avisar('Producto agregado a la venta abierta');
			return;
		}
		const nueva: Venta = {
			id: nuevoId(),
			creada: Date.now(),
			cliente: '',
			estado: 'abierta',
			productos: [producto],
		};
		ventaActivaId = nueva.id;
		await guardar(nueva, 'Producto agregado a una nueva venta abierta', producto.marca);
	}

	async function procesarFoto(foto: Blob | HTMLCanvasElement, desdeCamara: boolean) {
		const destino = ventaActiva();
		const control = abrirRevision({
			venta: destino,
			origen: 'ticket',
			productos,
			marcaSugerida: localStorage.getItem(ULTIMA_MARCA),
		});
		leerFoto(foto, {
			desdeCamara,
			conocidos: productos.map((p) => ({ nombre: p.nombre, precioKg: p.precioKg ?? undefined })),
			alAvanzar: control.progreso,
		})
			.then(({ lectura, miniatura }) => control.completar(lectura, miniatura))
			.catch((error) => {
				console.error('No se pudo leer el ticket', error);
				control.fallo(
					navigator.onLine
						? 'No se pudo leer la foto. Cargá los datos a mano mirando la etiqueta.'
						: 'El lector todavía no está guardado en el celular: abrí la app una vez con internet. Mientras, cargá los datos a mano.',
				);
			});
		const resultado = await control.resultado;
		if (resultado) await guardarProducto(resultado.producto, destino?.id ?? null);
	}

	async function agregarManual() {
		const destino = ventaActiva();
		const control = abrirRevision({
			venta: destino,
			origen: 'manual',
			productos,
			marcaSugerida: localStorage.getItem(ULTIMA_MARCA),
		});
		const resultado = await control.resultado;
		if (resultado) await guardarProducto(resultado.producto, destino?.id ?? null);
	}

	async function crearVenta() {
		const nueva: Venta = { id: nuevoId(), creada: Date.now(), cliente: '', estado: 'abierta', productos: [] };
		ventaActivaId = nueva.id;
		await guardar(nueva, 'Venta nueva lista para cargar productos');
	}

	async function cambiarCliente(venta: Venta, cliente: string) {
		const actualizada = await actualizarVenta(venta.id, (actual) => (actual.estado === 'abierta' ? { ...actual, cliente } : null));
		await refrescar();
		if (actualizada?.estado !== 'abierta') avisar('Esa venta ya no está abierta.');
	}

	async function finalizar(venta: Venta) {
		const numero = abiertasActuales().findIndex((v) => v.id === venta.id) + 1;
		const cobro = await abrirCobro(venta, { detalle: venta.cliente ? `Venta ${numero} · ${venta.cliente}` : `Venta ${numero}` });
		if (cobro.accion === 'volver') {
			// La venta queda pendiente; se guardan los pagos y la nota para retomarlos.
			const igual = JSON.stringify(cobro.pagos) === JSON.stringify(venta.pagos ?? []) && cobro.nota === (venta.nota ?? '');
			if (igual) return;
			await actualizarVenta(venta.id, (actual) =>
				actual.estado === 'abierta' ? { ...actual, pagos: cobro.pagos, nota: cobro.nota || undefined } : null,
			);
			await refrescar();
			avisar('La venta quedó pendiente de cobro');
			return;
		}
		const actualizada = await actualizarVenta(venta.id, (actual) => {
			const total = actual.productos.reduce((s, p) => s + p.total, 0);
			const cubre = estadoCobro(total, cobro.pagos).completo;
			return actual.estado === 'abierta' && actual.productos.length && cubre
				? { ...actual, pagos: cobro.pagos, nota: cobro.nota || undefined, estado: 'finalizada', finalizada: Date.now() }
				: null;
		});
		if (actualizada?.estado !== 'finalizada') {
			avisar('No se pudo cobrar: la venta cambió. Revisala y volvé a intentar.');
			await refrescar();
			return;
		}
		void pedirAlmacenamientoPersistente();
		await refrescar();
		avisar('Venta cobrada', { texto: 'Ver ventas del día', alTocar: () => mostrarPestana('dia') });
	}

	/** Cobra lo que quedó debiendo una venta ya finalizada. */
	async function saldar(venta: Venta) {
		const debe = deuda(venta.pagos);
		if (!debe) return;
		const detalle = venta.nota || venta.cliente || `Venta de las ${hora(venta.finalizada ?? venta.creada)}`;
		const cobro = await abrirCobro(venta, { detalle, deuda: debe });
		if (cobro.accion === 'volver') {
			if (cobro.nota === (venta.nota ?? '')) return;
			await actualizarVenta(venta.id, (actual) => ({ ...actual, nota: cobro.nota || undefined }));
			await refrescar();
			return;
		}
		const actualizada = await actualizarVenta(venta.id, (actual) =>
			actual.estado === 'finalizada' && deuda(actual.pagos) === debe
				? {
						...actual,
						pagos: [...(actual.pagos ?? []).filter((p) => p.metodo !== 'debe'), ...cobro.pagos],
						nota: cobro.nota || undefined,
					}
				: null,
		);
		await refrescar();
		const sigue = deuda(actualizada?.pagos);
		if (sigue === debe) avisar('La venta cambió y no se registró el pago. Revisala.');
		else avisar(sigue > 0 ? `Pago registrado. Sigue debiendo ${pesos(sigue)}` : 'Deuda saldada');
	}

	async function cancelar(venta: Venta) {
		if (venta.productos.length === 0) {
			const eliminada = await borrarVentaVacia(venta.id);
			await refrescar();
			avisar(eliminada ? 'Se cerró la venta vacía' : 'La venta ya cambió; revisá la venta activa.');
			return;
		}
		const nombre = venta.cliente ? `de ${venta.cliente}` : 'sin cliente identificado';
		if (!window.confirm(`¿Cancelar la venta ${nombre}? No se contará en los totales.`)) return;
		const actualizada = await actualizarVenta(venta.id, (actual) => (actual.estado === 'abierta' ? { ...actual, estado: 'cancelada' } : null));
		await refrescar();
		avisar(actualizada?.estado === 'cancelada' ? 'Venta cancelada' : 'Esa venta ya no está abierta.');
	}

	async function editar(venta: Venta, producto: ProductoVenta) {
		const control = abrirRevision({ venta, productoVenta: producto, origen: producto.origen, productos });
		const resultado = await control.resultado;
		if (!resultado) return;
		const actualizada = await actualizarVenta(venta.id, (actual) => {
			if (actual.estado !== 'finalizada' || !actual.productos.some((p) => p.id === producto.id)) return null;
			return {
				...actual,
				productos: actual.productos.map((p) => (p.id === producto.id ? resultado.producto : p)),
			};
		});
		const guardado = actualizada?.productos.some(
			(p) => p.id === producto.id && p.producto === resultado.producto.producto && p.total === resultado.producto.total,
		);
		if (actualizada?.estado !== 'finalizada' || !guardado) {
			avisar('La venta cambió y no se pudieron guardar los cambios.');
			await refrescar();
			return;
		}
		localStorage.setItem(ULTIMA_MARCA, resultado.marca);
		await refrescar();
		avisar('Cambios guardados');
	}

	async function borrar(venta: Venta) {
		const detalle = venta.cliente ? `de ${venta.cliente}` : 'seleccionada';
		if (!window.confirm(`¿Borrar la venta ${detalle} del historial?`)) return;
		await borrarVenta(venta.id);
		await refrescar();
		avisar('Venta borrada');
	}

	btnCamara.addEventListener('click', () => {
		void ejecutar(async () => {
			void prepararLector().catch(() => {});
			if (!hayCamara()) {
				inputCamaraSistema.click();
				return;
			}
			const elegida = await abrirCamara();
			if (elegida) await procesarFoto(elegida.foto, elegida.tipo === 'camara');
		}, 'No se pudo abrir la cámara. Podés elegir una foto o cargar a mano.');
	});

	inputCamaraSistema.addEventListener('change', () => {
		const archivo = inputCamaraSistema.files?.[0];
		inputCamaraSistema.value = '';
		if (archivo) void ejecutar(() => procesarFoto(archivo, false), 'No se pudo agregar el producto. Intentá de nuevo.');
	});

	btnGaleria.addEventListener('click', () => void prepararLector().catch(() => {}));
	inputGaleria.addEventListener('change', () => {
		const archivo = inputGaleria.files?.[0];
		inputGaleria.value = '';
		if (archivo) void ejecutar(() => procesarFoto(archivo, false), 'No se pudo agregar el producto. Intentá de nuevo.');
	});

	btnManual.addEventListener('click', () =>
		void ejecutar(agregarManual, 'No se pudo agregar el producto. Intentá de nuevo.'),
	);
	btnExportar.addEventListener('click', () =>
		void ejecutar(() => exportarVentas(ventas.filter((v) => v.estado === 'finalizada')), 'No se pudo exportar las ventas.'),
	);

	btnReporte.addEventListener('click', () => reportar(Date.now()));

	// Al pasar la medianoche (feria nocturna) o volver a la app, el resumen de "hoy" se actualiza.
	document.addEventListener('visibilitychange', () => {
		if (document.visibilityState === 'visible') {
			void refrescar().catch((error) => {
				console.error(error);
				avisar('No se pudieron actualizar las ventas guardadas.');
			});
		}
	});

	refrescar().catch((error) => {
		console.error(error);
		avisar('No se pudieron cargar las ventas guardadas.');
	});

	// El lector de tickets tarda unos segundos en cargar su motor y el modelo de
	// español: se prepara apenas el celular queda libre, así el primer escaneo
	// no espera. Si falla (por ejemplo, sin el modelo en caché), se reintenta al escanear.
	const cuandoEsteLibre = window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 1500));
	cuandoEsteLibre(() => void prepararLector().catch(() => {}));
</script>

