---
import Layout from '../layouts/Layout.astro';
import Splash from '../components/Splash.astro';
---

<Layout>
	<Splash />

	<header class="barra">
		<img class="productor" src="/img/huella-pampa.jpg" alt="Huella Pampa" width="150" height="150" />
		<div>
			<p class="titulo">Ventas de Feria</p>
			<p class="subtitulo">Lácteos Huella Pampa</p>
		</div>
	</header>

	<main class="contenido">
		<section class="tarjeta">
			<h1>Registro de ventas</h1>
			<p>Acá vas a poder anotar lo que vendas en el Mercado Bonaerense, incluso sin conexión.</p>
		</section>
	</main>
</Layout>

<style>
	.barra {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: max(0.75rem, env(safe-area-inset-top)) 1rem 0.75rem;
		background: var(--degrade);
		color: #fff;
	}

	.barra .productor {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #fff;
	}

	.titulo {
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.2;
	}

	.subtitulo {
		font-size: 0.85rem;
		opacity: 0.9;
	}

	.contenido {
		padding: 1.25rem 1rem;
	}

	.tarjeta {
		background: var(--superficie);
		border-radius: var(--radio);
		padding: 1.5rem;
		box-shadow: 0 4px 12px rgb(0 0 0 / 0.06);
	}

	.tarjeta h1 {
		font-size: 1.35rem;
		margin-bottom: 0.5rem;
	}

	.tarjeta p {
		color: var(--texto-suave);
		line-height: 1.5;
	}
</style>
