---
import Layout from '../layouts/Layout.astro';
import Splash from '../components/Splash.astro';
import Camara from '../components/Camara.astro';
import Revision from '../components/Revision.astro';
import { ruta } from '../lib/rutas';
---

<Layout>
	<Splash />

	<header class="barra">
		<img class="productor" src={ruta('img/huella-pampa.jpg')} alt="Huella Pampa" width="150" height="150" />
		<div>
			<p class="titulo">Ventas de Feria</p>
			<p class="subtitulo">Lácteos Huella Pampa</p>
		</div>
	</header>

	<main class="contenido">
		<section class="resumen" aria-labelledby="resumen-titulo">
			<h1 id="resumen-titulo">Vendido hoy</h1>
			<p id="resumen-total" class="resumen-total">$ 0,00</p>
			<p id="resumen-detalle" class="resumen-detalle">Todavía no hay ventas hoy</p>
			<ul id="resumen-marcas" class="resumen-marcas" aria-label="Total por marca"></ul>
		</section>

		<section class="acciones" aria-label="Anotar una venta">
			<button id="btn-camara" class="accion principal" type="button" hidden>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M4 8a2 2 0 0 1 2-2h2l1.5-2h5L16 6h2a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"></path>
					<circle cx="12" cy="13" r="3.5"></circle>
				</svg>
				<span>
					<strong>Escanear ticket</strong>
					<small>Sacale una foto a la etiqueta de la balanza</small>
				</span>
			</button>

			<label id="btn-galeria" class="accion principal">
				<input id="input-galeria" type="file" accept="image/*" hidden />
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="3" y="4" width="18" height="16" rx="3"></rect>
					<circle cx="9" cy="10" r="2"></circle>
					<path d="M21 16l-5-5-9 9"></path>
				</svg>
				<span>
					<strong>Cargar foto del ticket</strong>
					<small>Elegí una foto de la etiqueta de la balanza</small>
				</span>
			</label>

			<!-- Respaldo de la cámara si el navegador no deja usarla dentro de la app. -->
			<input id="input-camara-sistema" type="file" accept="image/*" capture="environment" hidden />

			<button id="btn-manual" class="accion texto" type="button">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4"></path></svg>
				Cargar a mano
			</button>
		</section>

		<section class="ventas" aria-labelledby="ventas-titulo">
			<header class="ventas-cabecera">
				<h2 id="ventas-titulo">Ventas</h2>
				<button id="btn-exportar" class="exportar" type="button" disabled>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
					Exportar
				</button>
			</header>
			<div id="lista-ventas" class="lista"></div>
		</section>
	</main>

	<div id="aviso" class="aviso" role="status" aria-live="polite" hidden></div>

	<Camara />
	<Revision />
</Layout>

<script>
	import { abrirCamara, esCelular, hayCamara } from '../lib/ui/camara';
	import { abrirRevision } from '../lib/ui/revision';
	import { avisar, dibujarLista, dibujarResumen } from '../lib/ui/lista';
	import { leerFoto, prepararLector } from '../lib/tickets/lector';
	import {
		borrarVenta,
		guardarVenta,
		listarProductos,
		listarVentas,
		pedirAlmacenamientoPersistente,
		type Producto,
		type Venta,
	} from '../lib/ventas/db';
	import { exportarVentas } from '../lib/ventas/exportar';

	const lista = document.getElementById('lista-ventas')!;
	const btnCamara = document.getElementById('btn-camara') as HTMLButtonElement;
	const btnGaleria = document.getElementById('btn-galeria')!;
	const inputGaleria = document.getElementById('input-galeria') as HTMLInputElement;
	const inputCamaraSistema = document.getElementById('input-camara-sistema') as HTMLInputElement;
	const btnManual = document.getElementById('btn-manual') as HTMLButtonElement;
	const btnExportar = document.getElementById('btn-exportar') as HTMLButtonElement;

	let ventas: Venta[] = [];
	let productos: Producto[] = [];

	// En el celular: cámara de la app + galería. En la PC: solo cargar una foto.
	if (esCelular()) {
		btnCamara.hidden = false;
		btnGaleria.classList.replace('principal', 'secundaria');
		btnGaleria.querySelector('strong')!.textContent = 'Elegir de la galería';
		btnGaleria.querySelector('small')!.textContent = 'Una foto que ya sacaste del ticket';
	}

	const ULTIMA_MARCA = 'ultima-marca';

	async function refrescar() {
		[ventas, productos] = await Promise.all([listarVentas(), listarProductos()]);
		dibujarResumen(ventas);
		dibujarLista(lista, ventas, { alEditar: editar, alBorrar: borrar });
		btnExportar.disabled = ventas.length === 0;
	}

	async function guardar(venta: Venta, mensaje: string) {
		await guardarVenta(venta);
		localStorage.setItem(ULTIMA_MARCA, venta.marca);
		void pedirAlmacenamientoPersistente();
		await refrescar();
		avisar(mensaje);
	}

	async function procesarFoto(foto: Blob | HTMLCanvasElement, desdeCamara: boolean) {
		const control = abrirRevision({ origen: 'ticket', productos, marcaSugerida: localStorage.getItem(ULTIMA_MARCA) });
		leerFoto(foto, {
			desdeCamara,
			conocidos: productos.map((p) => ({ nombre: p.nombre, precioKg: p.precioKg ?? undefined })),
			alAvanzar: control.progreso,
		})
			.then(({ lectura, miniatura }) => control.completar(lectura, miniatura))
			.catch((error) => {
				console.error('No se pudo leer el ticket', error);
				control.fallo(
					navigator.onLine
						? 'No se pudo leer la foto. Cargá los datos a mano mirando el ticket.'
						: 'El lector todavía no está guardado en el celular: abrí la app una vez con internet. Mientras, cargá los datos a mano.',
				);
			});
		const venta = await control.resultado;
		if (venta) await guardar(venta, 'Venta guardada');
	}

	async function editar(venta: Venta) {
		const control = abrirRevision({ venta, origen: venta.origen, productos });
		const editada = await control.resultado;
		if (editada) await guardar(editada, 'Cambios guardados');
	}

	async function borrar(venta: Venta) {
		await borrarVenta(venta.id);
		await refrescar();
		avisar(`Se borró ${venta.producto}`, {
			texto: 'Deshacer',
			alTocar: () => void guardar(venta, 'Venta recuperada'),
		});
	}

	btnCamara.addEventListener('click', async () => {
		void prepararLector().catch(() => {});
		if (!hayCamara()) {
			inputCamaraSistema.click();
			return;
		}
		const elegida = await abrirCamara();
		if (elegida) await procesarFoto(elegida.foto, elegida.tipo === 'camara');
	});

	inputCamaraSistema.addEventListener('change', () => {
		const archivo = inputCamaraSistema.files?.[0];
		inputCamaraSistema.value = '';
		if (archivo) void procesarFoto(archivo, false);
	});

	btnGaleria.addEventListener('click', () => void prepararLector().catch(() => {}));
	inputGaleria.addEventListener('change', () => {
		const archivo = inputGaleria.files?.[0];
		inputGaleria.value = '';
		if (archivo) void procesarFoto(archivo, false);
	});

	btnManual.addEventListener('click', async () => {
		const control = abrirRevision({ origen: 'manual', productos, marcaSugerida: localStorage.getItem(ULTIMA_MARCA) });
		const venta = await control.resultado;
		if (venta) await guardar(venta, 'Venta guardada');
	});

	btnExportar.addEventListener('click', () => void exportarVentas(ventas));

	// Al pasar la medianoche (feria nocturna) o volver a la app, el resumen de "hoy" se actualiza.
	document.addEventListener('visibilitychange', () => {
		if (document.visibilityState === 'visible') void refrescar();
	});

	refrescar().catch((error) => {
		console.error(error);
		avisar('No se pudieron cargar las ventas guardadas.');
	});
</script>

<style>
	.barra {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: max(0.75rem, env(safe-area-inset-top)) 1rem 0.75rem;
		background: var(--degrade);
		color: #fff;
	}

	.barra .productor {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #fff;
	}

	.titulo {
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.2;
	}

	.subtitulo {
		font-size: 0.85rem;
		opacity: 0.9;
	}

	.contenido {
		display: grid;
		gap: 1.25rem;
		max-width: 640px;
		margin: 0 auto;
		padding: 1.25rem 1rem calc(5rem + env(safe-area-inset-bottom));
	}

	/* --- Resumen del día --- */
	.resumen {
		padding: 1.25rem 1.25rem 1rem;
		border-radius: var(--radio);
		background: var(--superficie);
		box-shadow: 0 4px 16px rgb(0 0 0 / 0.06);
	}

	.resumen h1 {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--texto-suave);
	}

	.resumen-total {
		font-size: 2.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: var(--degrade);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.resumen-detalle {
		color: var(--texto-suave);
		font-size: 0.92rem;
	}

	.resumen-marcas {
		list-style: none;
		display: grid;
		gap: 0.4rem;
		margin-top: 0.75rem;
	}

	.resumen-marcas:empty {
		display: none;
	}

	.resumen-marcas :global(li) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
	}

	.resumen-marcas :global(img) {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		object-fit: contain;
		background: #fff;
		box-shadow: 0 0 0 1px #eee;
	}

	.resumen-marcas :global(strong) {
		margin-left: auto;
	}

	/* --- Acciones --- */
	.acciones {
		display: grid;
		gap: 0.75rem;
	}

	.accion {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		width: 100%;
		padding: 1rem 1.1rem;
		border: 0;
		border-radius: var(--radio);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.accion[hidden] {
		display: none;
	}

	.accion svg {
		flex: none;
		width: 30px;
		height: 30px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.accion span {
		display: grid;
		gap: 0.1rem;
	}

	.accion strong {
		font-size: 1.1rem;
	}

	.accion small {
		font-size: 0.85rem;
		opacity: 0.85;
	}

	.principal {
		background: var(--degrade);
		color: #fff;
		box-shadow: 0 8px 20px rgb(232 31 118 / 0.25);
	}

	.secundaria {
		background: var(--superficie);
		color: var(--texto);
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.06);
	}

	.secundaria svg {
		color: var(--celeste);
	}

	.accion:active {
		transform: scale(0.99);
	}

	.accion:focus-visible,
	.accion:has(input:focus-visible) {
		outline: 3px solid rgb(0 174 195 / 0.5);
		outline-offset: 2px;
	}

	.texto {
		justify-content: center;
		padding: 0.6rem;
		background: none;
		color: var(--rosa);
		font-weight: 600;
	}

	.texto svg {
		width: 20px;
		height: 20px;
	}

	/* --- Lista de ventas --- */
	.ventas-cabecera {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}

	.ventas-cabecera h2 {
		font-size: 1.15rem;
	}

	.exportar {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.5rem 0.9rem;
		border: 1.5px solid var(--celeste);
		border-radius: 999px;
		background: none;
		color: #00838f;
		font: inherit;
		font-weight: 600;
		font-size: 0.9rem;
		cursor: pointer;
	}

	.exportar:disabled {
		opacity: 0.4;
		cursor: default;
	}

	.exportar svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.lista {
		display: grid;
		gap: 1.25rem;
	}

	.lista :global(.lista-vacia) {
		padding: 1.5rem 1rem;
		border: 1.5px dashed #d5d5dd;
		border-radius: var(--radio);
		color: var(--texto-suave);
		text-align: center;
		line-height: 1.5;
	}

	.lista :global(.dia h3) {
		display: flex;
		justify-content: space-between;
		padding: 0 0.25rem 0.4rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--texto-suave);
	}

	.lista :global(.dia ul) {
		list-style: none;
		border-radius: var(--radio);
		background: var(--superficie);
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.05);
		overflow: hidden;
	}

	.lista :global(.venta) {
		display: flex;
		align-items: center;
	}

	.lista :global(.venta + .venta) {
		border-top: 1px solid #f0f0f3;
	}

	.lista :global(.venta-principal) {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.8rem 0.25rem 0.8rem 0.9rem;
		border: 0;
		background: none;
		font: inherit;
		color: inherit;
		text-align: left;
		cursor: pointer;
	}

	.lista :global(.venta-logo) {
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: contain;
		background: #fff;
		box-shadow: 0 0 0 1px #eee;
	}

	.lista :global(.venta-info) {
		flex: 1;
		min-width: 0;
		display: grid;
	}

	.lista :global(.venta-producto) {
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.lista :global(.venta-detalle) {
		font-size: 0.8rem;
		color: var(--texto-suave);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.lista :global(.venta-total) {
		font-weight: 700;
		white-space: nowrap;
	}

	.lista :global(.venta-borrar) {
		flex: none;
		width: 44px;
		height: 44px;
		margin-right: 0.35rem;
		border: 0;
		border-radius: 50%;
		background: none;
		color: #a0a0ab;
		display: grid;
		place-items: center;
		cursor: pointer;
	}

	.lista :global(.venta-borrar:hover),
	.lista :global(.venta-borrar:focus-visible) {
		color: var(--rosa);
		background: #fdeef5;
	}

	.lista :global(.venta-borrar svg) {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* --- Aviso --- */
	.aviso {
		position: fixed;
		left: 50%;
		bottom: max(1rem, env(safe-area-inset-bottom));
		z-index: 60;
		transform: translateX(-50%);
		width: min(92vw, 480px);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1rem;
		border-radius: 14px;
		background: #1d1d26;
		color: #fff;
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
		animation: aparecer 0.2s ease-out;
	}

	.aviso[hidden] {
		display: none;
	}

	.aviso :global(button) {
		flex: none;
		border: 0;
		background: none;
		color: #6fe3f0;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	@keyframes aparecer {
		from {
			opacity: 0;
			transform: translate(-50%, 12px);
		}
	}
</style>
