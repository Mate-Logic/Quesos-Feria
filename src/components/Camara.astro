---
// Cámara a pantalla completa con un recuadro para encuadrar la etiqueta de la
// balanza. Solo se recorta lo que queda dentro del recuadro, así el lector no
// tiene que buscar el ticket en la foto. Se controla desde src/lib/ui/camara.ts.
---

<div id="camara" class="camara" role="dialog" aria-modal="true" aria-label="Sacar foto del ticket" hidden>
	<video id="camara-video" class="video" playsinline muted autoplay></video>

	<div class="guia" aria-hidden="true">
		<div id="camara-recuadro" class="recuadro">
			<span class="esquina arriba-izq"></span>
			<span class="esquina arriba-der"></span>
			<span class="esquina abajo-izq"></span>
			<span class="esquina abajo-der"></span>
			<span class="barrido"></span>
		</div>
	</div>

	<header class="cabecera">
		<button id="camara-cerrar" class="redondo" type="button" aria-label="Cerrar la cámara">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
		</button>
		<div class="indicacion">
			<p class="titulo">Encuadrá la etiqueta</p>
			<p class="detalle">Que se lean el peso, el precio y el total</p>
		</div>
	</header>

	<p id="camara-estado" class="estado" role="status" hidden></p>

	<footer class="controles">
		<label class="redondo" aria-label="Elegir una foto de la galería">
			<input id="camara-galeria" type="file" accept="image/*" hidden />
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<rect x="3" y="4" width="18" height="16" rx="3"></rect>
				<circle cx="9" cy="10" r="2"></circle>
				<path d="M21 16l-5-5-9 9"></path>
			</svg>
		</label>
		<button id="camara-disparar" class="disparador" type="button" aria-label="Sacar la foto" disabled>
			<span></span>
		</button>
		<button id="camara-linterna" class="redondo" type="button" aria-label="Prender la linterna" aria-pressed="false" hidden>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z"></path></svg>
		</button>
		<span class="redondo fantasma" aria-hidden="true"></span>
	</footer>
</div>

<style>
	.camara {
		position: fixed;
		inset: 0;
		z-index: 50;
		background: #000;
		color: #fff;
		overflow: hidden;
		touch-action: none;
	}

	.camara[hidden] {
		display: none;
	}

	.video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* El recuadro: todo lo de afuera se oscurece con una sombra enorme. */
	.guia {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding-bottom: 4rem;
		pointer-events: none;
	}

	.recuadro {
		position: relative;
		width: min(86vw, 440px);
		aspect-ratio: 5 / 4;
		border-radius: 22px;
		box-shadow: 0 0 0 100vmax rgb(10 10 20 / 0.62);
		outline: 1px solid rgb(255 255 255 / 0.25);
	}

	.esquina {
		position: absolute;
		width: 44px;
		height: 44px;
		border: 5px solid var(--rosa);
		border-radius: 22px;
		filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.35));
	}

	.arriba-izq {
		top: -3px;
		left: -3px;
		border-right: 0;
		border-bottom: 0;
		border-radius: 22px 0 0 0;
	}

	.arriba-der {
		top: -3px;
		right: -3px;
		border-left: 0;
		border-bottom: 0;
		border-radius: 0 22px 0 0;
		border-color: var(--celeste);
	}

	.abajo-izq {
		bottom: -3px;
		left: -3px;
		border-right: 0;
		border-top: 0;
		border-radius: 0 0 0 22px;
		border-color: var(--celeste);
	}

	.abajo-der {
		bottom: -3px;
		right: -3px;
		border-left: 0;
		border-top: 0;
		border-radius: 0 0 22px 0;
	}

	/* Línea que recorre el recuadro: da la idea de "escaneo". */
	.barrido {
		position: absolute;
		left: 8%;
		right: 8%;
		top: 10%;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(90deg, transparent, var(--rosa), var(--celeste), transparent);
		box-shadow: 0 0 18px rgb(232 31 118 / 0.7);
		animation: barrer 2.4s ease-in-out infinite alternate;
	}

	.camara.capturando .barrido {
		animation-play-state: paused;
		opacity: 0;
	}

	.cabecera {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: max(1rem, env(safe-area-inset-top)) 1rem 1rem;
		background: linear-gradient(rgb(0 0 0 / 0.55), transparent);
	}

	.indicacion .titulo {
		font-weight: 700;
		font-size: 1.15rem;
	}

	.indicacion .detalle {
		font-size: 0.85rem;
		opacity: 0.85;
	}

	.estado {
		position: absolute;
		left: 1.5rem;
		right: 1.5rem;
		top: 50%;
		transform: translateY(-50%);
		padding: 1rem 1.25rem;
		border-radius: var(--radio);
		background: rgb(20 20 30 / 0.85);
		text-align: center;
		line-height: 1.45;
	}

	.controles {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		justify-content: space-around;
		padding: 1.5rem 1.5rem max(1.75rem, env(safe-area-inset-bottom));
		background: linear-gradient(transparent, rgb(0 0 0 / 0.6));
	}

	.redondo {
		flex: none;
		width: 52px;
		height: 52px;
		border: 0;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: rgb(255 255 255 / 0.16);
		backdrop-filter: blur(8px);
		color: #fff;
		cursor: pointer;
	}

	.redondo svg {
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.redondo[aria-pressed='true'] {
		background: #fff;
		color: var(--rosa);
	}

	.redondo[aria-pressed='true'] svg {
		fill: currentColor;
	}

	/* Ocupa el lugar de la linterna cuando el celular no tiene, para centrar el disparador. */
	.fantasma {
		visibility: hidden;
	}

	#camara-linterna:not([hidden]) + .fantasma {
		display: none;
	}

	.disparador {
		width: 78px;
		height: 78px;
		padding: 5px;
		border: 0;
		border-radius: 50%;
		background: var(--degrade);
		cursor: pointer;
		box-shadow: 0 6px 24px rgb(0 0 0 / 0.4);
	}

	.disparador span {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: #fff;
		border: 3px solid rgb(0 0 0 / 0.08);
		transition: transform 0.12s ease;
	}

	.disparador:active span {
		transform: scale(0.88);
	}

	.disparador:disabled {
		opacity: 0.4;
	}

	/* Destello al sacar la foto. */
	.camara.capturando::after {
		content: '';
		position: absolute;
		inset: 0;
		background: #fff;
		animation: destello 0.35s ease-out forwards;
		pointer-events: none;
	}

	@keyframes barrer {
		from {
			top: 10%;
		}
		to {
			top: 88%;
		}
	}

	@keyframes destello {
		from {
			opacity: 0.8;
		}
		to {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.barrido {
			animation: none;
			top: 50%;
		}
	}
</style>
