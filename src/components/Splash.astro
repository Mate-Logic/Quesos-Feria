---
// Pantalla de carga e inicio. Se muestra una vez por sesión al abrir la app
// y se oculta cuando la página terminó de cargar (con un mínimo para que se lea).
---

<div id="splash" class="splash" role="status" aria-live="polite" aria-label="Cargando la aplicación">
	<div class="marca">
		<div class="logo-productor">
			<img src="/img/huella-pampa.jpg" alt="Huella Pampa" width="150" height="150" />
		</div>
		<p class="app">Ventas de Feria</p>
		<p class="productor">Lácteos Huella Pampa · Chivilcoy</p>
	</div>

	<div class="carga" aria-hidden="true">
		<span></span>
	</div>

	<footer class="mercado">
		<img src="/img/mb-logo-blanco.webp" alt="Mercados Bonaerenses" width="900" height="302" />
	</footer>
</div>

<script is:inline>
	// Se ejecuta antes de pintar: si ya se vio en esta sesión, no se muestra de nuevo.
	if (sessionStorage.getItem('splash-visto')) {
		document.documentElement.classList.add('sin-splash');
	}
</script>

<script>
	const MINIMO_MS = 1400;
	const inicio = performance.now();
	const splash = document.getElementById('splash');

	const ocultar = () => {
		if (!splash) return;
		const espera = Math.max(0, MINIMO_MS - (performance.now() - inicio));
		setTimeout(() => {
			splash.classList.add('oculto');
			sessionStorage.setItem('splash-visto', '1');
			splash.addEventListener('transitionend', () => splash.remove(), { once: true });
			// Respaldo por si no hay transición (movimiento reducido).
			setTimeout(() => splash.remove(), 600);
		}, espera);
	};

	if (document.documentElement.classList.contains('sin-splash')) {
		splash?.remove();
	} else if (document.readyState === 'complete') {
		ocultar();
	} else {
		window.addEventListener('load', ocultar, { once: true });
	}
</script>

<style>
	.splash {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		grid-template-rows: 1fr auto auto;
		justify-items: center;
		gap: 2.5rem;
		padding: max(2rem, env(safe-area-inset-top)) 1.5rem max(2rem, env(safe-area-inset-bottom));
		background: var(--degrade);
		color: #fff;
		text-align: center;
		transition:
			opacity 0.45s ease,
			visibility 0.45s;
	}

	:global(.sin-splash) .splash {
		display: none;
	}

	.splash.oculto {
		opacity: 0;
		visibility: hidden;
	}

	.marca {
		align-self: center;
		display: grid;
		justify-items: center;
		gap: 0.5rem;
		animation: entrar 0.6s ease-out both;
	}

	.logo-productor {
		width: 160px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #fff;
		display: grid;
		place-items: center;
		overflow: hidden;
		margin-bottom: 1rem;
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
	}

	.logo-productor img {
		width: 150px;
		height: 150px;
	}

	.app {
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.productor {
		font-size: 0.95rem;
		font-weight: 400;
		opacity: 0.9;
	}

	.carga {
		width: 120px;
		height: 4px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.3);
		overflow: hidden;
	}

	.carga span {
		display: block;
		width: 40%;
		height: 100%;
		border-radius: inherit;
		background: #fff;
		animation: cargar 1.1s ease-in-out infinite;
	}

	.mercado img {
		width: min(200px, 55vw);
		height: auto;
	}

	@keyframes entrar {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.97);
		}
	}

	@keyframes cargar {
		from {
			transform: translateX(-100%);
		}
		to {
			transform: translateX(250%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.splash,
		.marca,
		.carga span {
			animation: none;
			transition: none;
		}
	}
</style>
