---
import { Font } from 'astro:assets';
import { pwaInfo } from 'virtual:pwa-info';
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Huella Pampa · Ventas de Feria' } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Registro de ventas de Lácteos Huella Pampa en los Mercados Bonaerenses." />
		<meta name="theme-color" content="#e81f76" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Ventas Feria" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
		<Font cssVariable="--font-encode-sans" preload />
		<title>{title}</title>
		{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
		<script src="../pwa.ts"></script>
	</head>
	<body>
		<slot />
	</body>
</html>
